# 复制成 .env 后填入真实凭证；真实环境变量优先级更高，可临时覆盖。
# 该文件不要提交到 git。

# 飞书自建应用（写入飞书在线文档）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 或用用户身份令牌替代上面两项（以“你本人”身份写入个人云空间）
# FEISHU_USER_ACCESS_TOKEN=
# 默认 https://open.feishu.cn ，如有私有化域名可覆盖
# FEISHU_BASE=

# iMa 知识库（通常已由 ~/.config/ima 提供，无需在此重复配置）
# IMA_OPENAPI_APIKEY=
# IMA_OPENAPI_CLIENTID=
# IMA_KNOWLEDGE_BASE_ID=
